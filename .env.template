# ─── Trading-AI Environment Variables ─────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ─── MT5 / Exness ────────────────────────────────────────
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial

# ─── Telegram Alerts ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── News API ────────────────────────────────────────────
NEWS_API_KEY=

# ─── Proxy (for Telegram in restricted regions) ─────────
# Format: socks5h://user:pass@host:port
PROXY_URL=

# ─── LLM Provider ───────────────────────────────────────
# "ollama" = free local LLM (default)
# "claude" = Anthropic Claude API (fast, ~$0.50-2/week)
LLM_PROVIDER=ollama

# ─── Claude API (only needed if LLM_PROVIDER=claude) ────
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=500

# ─── Ollama Local LLM (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ─── Trading Configuration ───────────────────────────────
ACTIVE_MARKET=EURUSD
TRADING_MODE=demo

# ─── Dashboard ───────────────────────────────────────────
# SHA-256 hash of your dashboard password (leave empty to disable auth)
DASHBOARD_PASSWORD_HASH=
